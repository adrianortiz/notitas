# =========================================================================
# COMPILATION & TEMPORARY FILES (Spring Boot / Maven)
# =========================================================================
*.class
*.log
target/

# Ignore all packaged files except the vital Maven Wrapper JAR
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Java Virtual Machine crash logs
hs_err_pid*
replay_pid*

# =========================================================================
# IDE CONFIGURATIONS (IntelliJ IDEA, VS Code, Eclipse, BlueJ)
# =========================================================================
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Visual Studio Code
.vscode/

# Eclipse
.classpath
.project
.settings/
.factorypath

# BlueJ & Legacy Mobile tools
*.ctxt
.mtj.tmp/

# =========================================================================
# LOCAL ENVIRONMENT & SENSITIVE FILES (Security)
# =========================================================================
# Local properties files containing private credentials or database keys
/src/main/resources/application-local.properties
/src/main/resources/application-local.yml

# Operating System temporary files
.DS_Store
Thumbs.db
